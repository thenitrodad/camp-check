{
  "expo": {
    "name": "CampCheck",
    "slug": "camp-check",
    "version": "1.3.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.png",
    "scheme": "camp-check",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "17"
    },
    "android": {
      "package": "com.campcheck.app",
      "versionCode": 27,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-new.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "41319485-1d38-4136-adb9-4487940509da"
      }
    },
    "owner": "thenitrodads-team"
  }
}
